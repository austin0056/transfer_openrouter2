# Required: OpenRouter key (upstream)
OPENROUTER_API_KEY=sk-or-v1-...

# Required: key that Cursor / clients use to call this gateway
GATEWAY_API_KEY=your-secret-gateway-key

# Default model (OpenRouter slug)
UPSTREAM_MODEL=anthropic/claude-opus-4.6

# Optional: SOCKS5 or HTTP proxy for outbound calls to OpenRouter
# Example: socks5://user:pass@host:1080
HTTPS_PROXY=

# Optional: PostgreSQL (with pgvector). If unset, persistence and embeddings are disabled.
DATABASE_URL=postgresql://user:pass@localhost:5432/gateway

# Anthropic automatic prompt caching via OpenRouter (see docs)
CACHE_ENABLED=true
# true = 1h TTL; false = 5-minute ephemeral TTL
CACHE_TTL_1H=true

# Embeddings (OpenRouter OpenAI-compatible /embeddings)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
# Leave empty to reuse OPENROUTER_API_KEY
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# HTTP client tuning
REQUEST_TIMEOUT_SECONDS=600
CONNECT_TIMEOUT_SECONDS=30
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE=20
PERSIST_QUEUE_MAX=10000
EMBED_QUEUE_MAX=10000
